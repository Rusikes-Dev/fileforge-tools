# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Canonical site URL used in metadata, sitemap, robots.txt and OpenGraph tags.
# Must be the full production origin with no trailing slash.
# Set this in the Vercel project settings for Production, Preview and Development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Advertising (optional)
# ---------------------------------------------------------------------------
# Ads render only when NEXT_PUBLIC_ADS_ENABLED is "true" AND the relevant slot
# ID below is set. Leave disabled locally and in preview deployments so review
# traffic and development never generate impressions.
NEXT_PUBLIC_ADS_ENABLED=false

# Your AdSense publisher ID, including the "ca-pub-" prefix.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Per-placement ad unit IDs, from AdSense → Ads → By ad unit.
# Any placement left blank simply renders nothing.
NEXT_PUBLIC_AD_SLOT_BELOW_RESULT=
NEXT_PUBLIC_AD_SLOT_CONTENT=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
